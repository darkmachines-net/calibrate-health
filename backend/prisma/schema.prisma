// PostgreSQL account, immutable food-log, metric, planning, session, and synchronization persistence.
// Applied migration history is immutable; schema changes require a new ordinal migration (see README.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum WeightUnit {
  KG
  LB
}

enum HeightUnit {
  CM
  FT_IN
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ActivityRecordType {
  STEPS
  ACTIVE_CALORIES
  TOTAL_CALORIES
  EXERCISE_SESSION
  WEIGHT
}

enum MealPeriod {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
}

enum MyFoodType {
  FOOD
  RECIPE
}

enum RecipeIngredientSource {
  MY_FOOD
  EXTERNAL
}

enum InAppNotificationType {
  LOG_WEIGHT_REMINDER
  LOG_FOOD_REMINDER
  GENERIC
}

enum MobileDevicePlatform {
  ANDROID_PHONE
  IOS
  WEAR_OS
}

enum NativePushPlatform {
  ANDROID
  IOS
}

enum NativePushProvider {
  EXPO
  FCM
}

enum FoodLogDayStatus {
  OPEN
  COMPLETE
  INCOMPLETE
  PAUSED
}

enum FoodLogDayOrigin {
  USER
  PAUSE
  IMPORT
}

enum CalibrationRecommendationStatus {
  PENDING
  APPLIED
  STALE
}

enum CaloriePlanReviewStatus {
  CLEAR
  REQUIRES_REVIEW
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash     String
  /// Monotonic credential/security generation; database trigger advances it on password changes.
  credential_security_version Int @default(0)
  /// Prepared immutable provider mapping; existence does not switch credential authority.
  firebase_identity FirebaseIdentity?
  created_at        DateTime  @default(now())
  email_verified_at DateTime?
  /// Set only after the required onboarding writes commit together.
  onboarding_completed_at DateTime?

  weight_unit   WeightUnit @default(KG)
  height_unit   HeightUnit @default(CM)
  /// IANA time zone identifier (e.g. "America/Los_Angeles") used to define the user's local day boundary.
  timezone      String     @default("UTC")
  /// Preferred UI language (short code like "en", "es", "fr", "ru").
  language      String     @default("en")
  /// Account-level preference for weight reminder notifications across devices.
  reminder_log_weight_enabled Boolean @default(true)
  /// Account-level preference for food reminder notifications across devices.
  reminder_log_food_enabled   Boolean @default(true)
  /// Weight reminder local wall-clock minute (0-1439), interpreted in timezone.
  reminder_log_weight_minute  Int     @default(540)
  /// Food reminder local wall-clock minute (0-1439), interpreted in timezone.
  reminder_log_food_minute    Int     @default(540)
  /// Optional quiet-hours start/end local wall-clock minutes; both null disables quiet hours.
  reminder_quiet_hours_start_minute Int?
  reminder_quiet_hours_end_minute   Int?
  /// Account-level preference that enables/disables app haptic feedback patterns.
  haptics_enabled             Boolean @default(true)
  date_of_birth DateTime? @db.Date
  sex           Sex?
  height_mm     Int?
  activity_level ActivityLevel?
  /// Optional, processed profile photo (small square) used for in-app avatars.
  profile_image Bytes?
  /// MIME type for the stored profile_image bytes (e.g. "image/jpeg").
  profile_image_mime_type String?
  
  goals         Goal[]
  metrics       BodyMetric[]
  food_logs     FoodLog[]
  food_log_days FoodLogDay[]
  daily_calorie_plans DailyCaloriePlan[]
  food_tracking_pauses FoodTrackingPause[]
  /// User-owned library of reusable foods and recipes for quick logging.
  my_foods      MyFood[]
  /// Web push subscriptions for reminder notifications.
  push_subscriptions PushSubscription[]
  /// Native mobile auth sessions keyed by hashed opaque tokens.
  mobile_sessions MobileAuthSession[]
  /// One-time phone-issued Wear OS pairing credentials.
  wear_pairing_credentials WearPairingCredential[]
  /// Native push tokens for Android and iOS app builds.
  native_push_subscriptions NativePushSubscription[]
  /// Durable idempotency records for native/offline mutation replay.
  client_operations ClientOperation[]
  /// Ordered mutation feed used by reconnecting clients.
  sync_changes SyncChange[]
  /// In-app reminder feed entries rendered in the notifications panel.
  in_app_notifications InAppNotification[]
  /// Browser sessions are linked after login so account deletion can revoke them by foreign key.
  browser_sessions SessionStore[]
  /// Source records imported from trusted native Health Connect clients.
  activity_records ActivityRecord[]
  /// Health Connect aggregate totals materialized per account-local day.
  activity_day_summaries ActivityDaySummary[]
  /// Per-device Health Connect change-token checkpoints.
  health_connect_sync_states HealthConnectSyncState[]
  /// Deleted Health Connect ids retained to prevent stale replay resurrection.
  health_connect_tombstones HealthConnectTombstone[]
  /// Materialized target suggestions generated from bounded food/weight evidence.
  calibration_recommendations CalibrationRecommendation[]
  /// Accepted target adjustments, dated so changes take effect on a user-local day boundary.
  calorie_plan_revisions CaloriePlanRevision[]
  /// Purpose-bound, one-time verification and recovery credentials. Only hashes are stored.
  account_action_tokens AccountActionToken[]
  /// Versioned user consent history for Terms and Privacy.
  legal_acceptances LegalAcceptance[]
  /// OAuth authorization codes issued after this account approves a remote MCP client.
  mcp_oauth_authorization_codes McpOAuthAuthorizationCode[]
  /// Revocable OAuth grants that let remote MCP clients read this account's selected data.
  mcp_oauth_grants McpOAuthGrant[]
}

model FirebaseIdentity {
  user_id Int @id
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  installation_id String
  source_id String
  project_id String
  uid String
  created_at DateTime @default(now())

  @@unique([project_id, uid])
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountActionToken {
  id          Int                 @id @default(autoincrement())
  user_id     Int
  user        User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  purpose     AccountTokenPurpose
  token_hash  String              @unique
  created_at  DateTime            @default(now())
  expires_at  DateTime
  consumed_at DateTime?

  @@index([user_id, purpose, consumed_at, expires_at])
}

model LegalAcceptance {
  id              Int      @id @default(autoincrement())
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  terms_version   String
  privacy_version String
  accepted_at     DateTime @default(now())

  @@unique([user_id, terms_version, privacy_version])
  @@index([user_id, accepted_at])
}

model McpOAuthClient {
  client_id String @id
  /// Complete dynamic-client-registration metadata. Client secrets are never accepted or stored.
  metadata_json Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  authorization_requests McpOAuthAuthorizationRequest[]
  authorization_codes McpOAuthAuthorizationCode[]
  grants McpOAuthGrant[]

  @@index([updated_at])
}

model McpOAuthAuthorizationRequest {
  /// Purpose-bound SHA-256 hash of the opaque request credential rendered in the approval form.
  request_hash String @id @db.VarChar(64)
  client_id String
  client McpOAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  redirect_uri String
  state String?
  scopes String[]
  code_challenge String
  resource String
  failed_attempts Int @default(0)
  created_at DateTime @default(now())
  expires_at DateTime
  @@index([expires_at])
  @@index([client_id, expires_at])
}

model McpOAuthAuthorizationCode {
  /// Purpose-bound SHA-256 hash of the one-use authorization code.
  code_hash String @id @db.VarChar(64)
  client_id String
  client McpOAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  redirect_uri String
  scopes String[]
  code_challenge String
  resource String
  created_at DateTime @default(now())
  expires_at DateTime
  @@index([expires_at])
  @@index([user_id, expires_at])
}

model McpOAuthGrant {
  /// Public revocation identifier. Credential hashes remain private.
  id String @id @default(uuid()) @db.Uuid
  client_id String
  client McpOAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  scopes String[]
  resource String
  created_at DateTime @default(now())
  last_used_at DateTime?
  revoked_at DateTime?
  access_tokens McpOAuthAccessToken[]
  refresh_tokens McpOAuthRefreshToken[]
  @@index([user_id, revoked_at, created_at(sort: Desc)])
  @@index([client_id, revoked_at])
}

model McpOAuthAccessToken {
  /// Purpose-bound SHA-256 hash of the opaque bearer token.
  token_hash String @id @db.VarChar(64)
  grant_id String @db.Uuid
  grant McpOAuthGrant @relation(fields: [grant_id], references: [id], onDelete: Cascade)
  scopes String[]
  created_at DateTime @default(now())
  expires_at DateTime
  @@index([grant_id, expires_at])
  @@index([expires_at])
}

model McpOAuthRefreshToken {
  /// Purpose-bound SHA-256 hash of the opaque rotating refresh token.
  token_hash String @id @db.VarChar(64)
  grant_id String @db.Uuid
  grant McpOAuthGrant @relation(fields: [grant_id], references: [id], onDelete: Cascade)
  scopes String[]
  created_at DateTime @default(now())
  expires_at DateTime
  used_at DateTime?
  @@index([grant_id, used_at, expires_at])
  @@index([expires_at])
}

model ActivityRecord {
  id                        Int                @id @default(autoincrement())
  user_id                   Int
  user                      User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Trusted device id from the bearer-authenticated mobile session.
  source_device_id          String
  record_type               ActivityRecordType
  /// Health Connect Metadata.id within the source device's Health Connect store.
  external_id               String
  /// Stable attribution for the app that originally wrote the Health Connect record.
  data_origin               String
  client_record_id          String?
  client_record_version     BigInt?
  source_updated_at         DateTime
  start_time                DateTime
  end_time                  DateTime?
  start_zone_offset_seconds Int?
  end_zone_offset_seconds   Int?
  /// Calendar day derived from start_time using the account timezone at ingestion.
  local_date                DateTime           @db.Date
  step_count                Int?
  energy_kcal               Float?
  weight_grams              Int?
  exercise_type             Int?
  title                     String?
  notes                     String?
  recording_method          Int?
  device_type               Int?
  device_manufacturer       String?
  device_model              String?
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt

  @@unique([user_id, source_device_id, record_type, external_id])
  @@index([user_id, local_date, start_time])
  @@index([user_id, record_type, data_origin, client_record_id])
}

model ActivityDaySummary {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Device whose Health Connect aggregate most recently supplied this canonical day.
  source_device_id      String
  local_date            DateTime @db.Date
  steps                 Int?
  active_calories_kcal  Float?
  total_calories_kcal   Float?
  exercise_minutes      Float?
  observed_at           DateTime
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([user_id, local_date])
}

model HealthConnectSyncState {
  id               Int                @id @default(autoincrement())
  user_id          Int
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_device_id String
  record_type      ActivityRecordType
  changes_token    String             @db.Text
  last_synced_at   DateTime
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  @@unique([user_id, source_device_id, record_type])
  @@index([user_id, source_device_id])
}

model HealthConnectTombstone {
  id               Int                @id @default(autoincrement())
  user_id          Int
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_device_id String
  record_type      ActivityRecordType
  external_id      String
  deleted_at       DateTime           @default(now())

  @@unique([user_id, source_device_id, record_type, external_id])
  @@index([user_id, deleted_at])
}

model Goal {
  id            Int       @id @default(autoincrement())
  user_id       Int
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  start_weight_grams  Int
  target_weight_grams Int
  target_date   DateTime?
  daily_deficit Int       @default(500)
  calorie_plan_review_status CaloriePlanReviewStatus @default(CLEAR)
  calorie_plan_review_reason String?
  created_at    DateTime  @default(now())
  calibration_recommendations CalibrationRecommendation[]
  calorie_plan_revisions CaloriePlanRevision[]

  @@index([user_id, created_at(sort: Desc), id(sort: Desc)])
}

model BodyMetric {
  id               Int      @id @default(autoincrement())
  user_id          Int
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  date             DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  weight_grams     Int
  body_fat_percent Float?
  /// Materialized trend/confidence values keyed to this day for fast chart responses.
  trend            BodyMetricTrend?
  
  @@unique([user_id, date])
}

model BodyMetricTrend {
  /// Uses the metric id as both primary key and relation key to enforce one trend row per metric.
  metric_id          Int       @id
  metric             BodyMetric @relation(fields: [metric_id], references: [id], onDelete: Cascade)
  /// Duplicated owner id keeps user-scoped deletes and maintenance queries simple.
  user_id            Int
  /// Duplicated metric date allows date-range operations without an additional join.
  date               DateTime  @db.Date
  /// Materialized latent trend estimate in grams.
  trend_weight_grams Int
  /// Materialized lower 95% confidence bound in grams.
  trend_ci_lower_grams Int
  /// Materialized upper 95% confidence bound in grams.
  trend_ci_upper_grams Int
  /// Materialized posterior standard deviation in grams.
  trend_std_grams    Int
  /// Materialized local rate estimate in grams per day when the model has enough evidence.
  trend_rate_grams_per_day Float?
  /// Materialized posterior standard deviation for the local rate in grams per day.
  trend_rate_std_grams_per_day Float?
  /// Version marker for invalidating persisted rows if model behavior changes later.
  model_version      Int       @default(1)
  /// SHA-256 fingerprint of the exact raw observations used by this materialized batch.
  source_revision    String?   @db.VarChar(64)
  /// Timestamp for operational visibility into the latest recompute.
  computed_at        DateTime  @default(now())

  @@index([user_id, date])
}

model FoodLog {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Optional link to a MyFood item (food/recipe) used to create this entry.
  /// This is informational only; the log remains a snapshot even if the MyFood changes later.
  my_food_id  Int?
  my_food     MyFood?  @relation(fields: [my_food_id], references: [id], onDelete: SetNull)
  date        DateTime @default(now())
  /// Calendar day for grouping logs, derived from the user's timezone at write time.
  local_date  DateTime @db.Date
  /// Fixed meal period for consistent grouping and UI display.
  meal_period MealPeriod
  name        String
  calories    Int
  /// Number of servings consumed for this entry (can be fractional).
  servings_consumed Float?
  /// Snapshot of the serving size (e.g. 1 "slice", 30 "g") used when logging.
  serving_size_quantity_snapshot Float?
  /// Snapshot of the serving unit label (free-form, e.g. "slice", "g", "ml") used when logging.
  serving_unit_label_snapshot String?
  /// Snapshot of calories per serving used when logging (so edits to MyFood do not mutate history).
  calories_per_serving_snapshot Float?
  /// If logged from an external provider, the provider name used to create the snapshot.
  external_source String?
  /// If logged from an external provider, the provider's stable food id when available.
  external_id     String?
  /// Optional brand copied from the external provider result.
  brand_snapshot  String?
  /// Optional locale copied from the external provider result.
  locale_snapshot String?
  /// Optional barcode copied from the external provider result.
  barcode_snapshot String?
  /// If logged from an external provider, the selected measure label used to compute calories.
  measure_label_snapshot       String?
  grams_per_measure_snapshot   Float?
  measure_quantity_snapshot    Float?
  grams_total_snapshot         Float?
  created_at  DateTime @default(now())

  @@index([user_id, local_date])
}

/// Last server-observed plan per local day; separate from food state and Wear revisions.
model DailyCaloriePlan {
  id Int @id @default(autoincrement())
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  local_date DateTime @db.Date
  timezone String
  observed_at DateTime
  calculation_version Int
  target_kcal Int?
  maintenance_kcal Int?
  /// Includes evaluated unavailable reasons and the exact profile, weight, goal and revisions used.
  inputs Json
  timezone_conflict Boolean @default(false)
  /// Consumption freezes both available and unavailable observations.
  consumed_at DateTime?

  @@unique([user_id, local_date])
}

model FoodLogDay {
  id           Int      @id @default(autoincrement())
  user_id      Int
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Calendar day for grouping logs, derived from the user's timezone at write time.
  local_date   DateTime @db.Date
  /// Permanent resolution for this local day. Only COMPLETE is representative.
  status       FoodLogDayStatus @default(OPEN)
  /// How this stored resolution was created.
  origin       FoodLogDayOrigin @default(USER)
  /// Timestamp of when the day was marked complete (cleared for other statuses).
  completed_at DateTime?
  /// Frozen comparison from a trustworthy server observation, consumed at first completion.
  comparison_target_kcal Int?
  comparison_maintenance_kcal Int?
  comparison_captured_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([user_id, local_date])
}

model FoodTrackingPause {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// First local date covered by the pause.
  starts_on            DateTime @db.Date
  /// Optional prompt date. This never resumes tracking automatically.
  expected_resume_on   DateTime? @db.Date
  /// First local date not covered by a closed pause.
  resumed_on           DateTime? @db.Date
  started_at           DateTime @default(now())
  resumed_at           DateTime?
  /// Most recent local date already persisted as PAUSED.
  materialized_through DateTime @db.Date
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([user_id, starts_on])
  @@index([user_id, resumed_on])
}

model CalibrationRecommendation {
  id                                Int                             @id @default(autoincrement())
  user_id                           Int
  user                              User                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_goal_id                    Int
  source_goal                       Goal                            @relation(fields: [source_goal_id], references: [id], onDelete: Cascade)
  input_fingerprint                 String
  model_version                     Int
  as_of_local_date                  DateTime                        @db.Date
  current_target_adjustment_kcal    Int
  recommended_target_adjustment_kcal Int
  current_target_kcal               Int
  recommended_target_kcal           Int
  status                            CalibrationRecommendationStatus @default(PENDING)
  result_snapshot                   Json
  created_at                        DateTime                        @default(now())
  applied_at                        DateTime?
  plan_revision                     CaloriePlanRevision?

  @@unique([user_id, input_fingerprint])
  @@index([user_id, status, created_at(sort: Desc)])
}

model CaloriePlanRevision {
  id                     Int                        @id @default(autoincrement())
  user_id                Int
  user                   User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_goal_id         Int
  source_goal            Goal                       @relation(fields: [source_goal_id], references: [id], onDelete: Cascade)
  recommendation_id      Int?                       @unique
  recommendation         CalibrationRecommendation? @relation(fields: [recommendation_id], references: [id], onDelete: SetNull)
  /// Non-null only for an intentional pace change; calibration rows inherit the dated pace.
  configured_daily_deficit Int?
  target_adjustment_kcal Int
  calorie_plan_review_status CaloriePlanReviewStatus @default(CLEAR)
  calorie_plan_review_reason String?
  effective_local_date   DateTime                   @db.Date
  created_at             DateTime                   @default(now())

  @@index([user_id, source_goal_id, effective_local_date(sort: Desc), id(sort: Desc)])
}

model MyFood {
  id          Int       @id @default(autoincrement())
  user_id     Int
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Indicates whether this item is a simple food (manual definition) or a composed recipe.
  type        MyFoodType
  name        String
  /// Serving size quantity for one serving unit (e.g. 1 "slice", 30 "g").
  serving_size_quantity Float
  /// Free-form serving unit label (e.g. "slice", "g", "ml").
  serving_unit_label String
  /// Calories per serving. For recipes, this is computed from ingredient snapshots and yield.
  calories_per_serving Float
  /// Per-user shortcut metadata; changing it never mutates recipe or food-log snapshots.
  is_pinned   Boolean   @default(false)
  /// For recipes: total calories across all ingredient snapshots.
  recipe_total_calories Float?
  /// For recipes: number of servings yielded by the recipe (can be fractional).
  yield_servings Float?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  /// Ingredients belonging to this recipe (only meaningful when type=RECIPE).
  recipe_ingredients RecipeIngredient[] @relation("RecipeToIngredients")
  /// Recipe ingredients that referenced this item at creation time (traceability only; recipes store snapshots).
  used_in_recipe_ingredients RecipeIngredient[] @relation("RecipeIngredientSourceFood")
  food_logs   FoodLog[]

  @@index([user_id, name])
  @@index([user_id, is_pinned(sort: Desc), name, id])
}

model RecipeIngredient {
  id          Int       @id @default(autoincrement())
  recipe_id   Int
  recipe      MyFood    @relation("RecipeToIngredients", fields: [recipe_id], references: [id], onDelete: Cascade)
  /// Stable ordering of ingredients within a recipe.
  sort_order  Int       @default(0)
  source      RecipeIngredientSource

  /// Snapshot display name for this ingredient.
  name_snapshot String
  /// Snapshot total calories contributed by this ingredient within the recipe.
  calories_total_snapshot Float

  /// If source=MY_FOOD, optional link back to the referenced MyFood for traceability only.
  source_my_food_id Int?
  source_my_food    MyFood? @relation("RecipeIngredientSourceFood", fields: [source_my_food_id], references: [id], onDelete: SetNull)
  /// If source=MY_FOOD, number of ingredient servings used in the recipe (can be fractional).
  quantity_servings Float?
  /// If source=MY_FOOD, snapshot of the ingredient's serving size.
  serving_size_quantity_snapshot Float?
  serving_unit_label_snapshot    String?
  calories_per_serving_snapshot  Float?

  /// If source=EXTERNAL, optional identifiers for the third-party item used to create the snapshot.
  external_source String?
  external_id     String?
  brand_snapshot  String?
  locale_snapshot String?
  barcode_snapshot String?

  /// If source=EXTERNAL, snapshot of the selected measure used to compute calories.
  measure_label_snapshot       String?
  grams_per_measure_snapshot   Float?
  measure_quantity_snapshot    Float?
  grams_total_snapshot         Float?

  created_at  DateTime  @default(now())

  @@index([recipe_id])
}

model ServerSettings {
  id                               Int      @id @default(1)
  nutrition_label_scanning_enabled Boolean  @default(false)
  updated_at                       DateTime @updatedAt
}

model SessionStore {
  /// Backing table for express-session; kept in the Prisma schema so db push and migrations create it.
  sid    String   @id @db.Text
  sess   Json
  expire DateTime @db.Timestamptz(6)
  /// Null before authentication; populated from Passport state once a user logs in.
  user_id Int?
  user    User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Public revocation identifier; never expose the cookie session id.
  public_id String @unique @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  /// Browser push endpoints owned by this authenticated session.
  push_subscriptions PushSubscription[]

  @@map("session_store")
  @@index([expire], map: "session_store_expire_idx")
  @@index([user_id], map: "session_store_user_id_idx")
}

model PushSubscription {
  id              Int      @id @default(autoincrement())
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_sid     String   @db.Text
  session         SessionStore @relation(fields: [session_sid], references: [sid], onDelete: Cascade)
  /// Browser-managed endpoint URL; globally unique so registering a shared browser transfers ownership.
  endpoint        String   @unique
  /// Base64-encoded p256dh key for payload encryption.
  p256dh          String
  /// Base64-encoded auth key for payload encryption.
  auth            String
  /// Optional expiration timestamp for the subscription.
  expiration_time DateTime?
  /// Local date (UTC-normalized) when the last reminder was sent for this subscription.
  last_sent_local_date DateTime? @db.Date
  last_sent_weight_local_date DateTime? @db.Date
  last_sent_food_local_date DateTime? @db.Date
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([user_id, endpoint])
  @@index([user_id])
  @@index([session_sid])
}

model MobileAuthSession {
  id                  Int                  @id @default(autoincrement())
  /// Public revocation identifier used by the unified account-session API.
  public_id           String               @unique @default(uuid()) @db.Uuid
  user_id             Int
  user                User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Stable per-install identifier supplied by the native client.
  device_id           String
  /// Native device class for Android, iOS, and Wear OS sessions.
  device_platform     MobileDevicePlatform
  /// Optional human-readable device label for account/device management.
  device_name         String?
  /// SHA-256 hash of the short-lived access token.
  access_token_hash   String               @unique
  /// SHA-256 hash of the long-lived refresh token.
  refresh_token_hash  String               @unique
  access_expires_at   DateTime
  refresh_expires_at  DateTime
  revoked_at          DateTime?
  last_used_at        DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  /// Push endpoints authenticated and registered by this native session.
  native_push_subscriptions NativePushSubscription[]
  /// Short-lived credentials this phone session issued for nearby Wear OS pairing.
  issued_wear_pairing_credentials WearPairingCredential[] @relation("WearPairingIssuer")
  /// Pairing exchange that created this Wear OS session, when applicable.
  created_from_wear_pairing_credential WearPairingCredential? @relation("WearPairingCreatedSession")
  /// Idempotent mutations issued by this native session when provenance is required (for example Wear undo).
  client_operations ClientOperation[]

  @@index([user_id])
  @@index([user_id, device_id, revoked_at])
}

model WearPairingCredential {
  id                        Int               @id @default(autoincrement())
  user_id                   Int
  user                      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  issuing_mobile_session_id Int
  issuing_mobile_session    MobileAuthSession @relation("WearPairingIssuer", fields: [issuing_mobile_session_id], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the one-time token transferred from phone to watch.
  token_hash                String            @unique
  /// Exact Calibrate origin selected on the phone; prevents cross-instance credential reuse.
  server_origin             String
  watch_device_id           String
  watch_device_name         String?
  protocol_version          Int
  /// Server-generated nonce signed by the watch's Android Keystore key.
  challenge                 String
  /// Base64 DER SubjectPublicKeyInfo for the watch's P-256 signing key.
  watch_public_key_spki     String            @db.Text
  /// SHA-256 of the client-generated UUID included in the successful signed exchange.
  exchange_id_hash          String?
  created_mobile_session_id Int?              @unique
  created_mobile_session    MobileAuthSession? @relation("WearPairingCreatedSession", fields: [created_mobile_session_id], references: [id], onDelete: SetNull)
  expires_at                DateTime
  consumed_at               DateTime?
  created_at                DateTime          @default(now())

  @@index([user_id, expires_at])
  @@index([issuing_mobile_session_id, expires_at])
}

model NativePushSubscription {
  id                    Int                @id @default(autoincrement())
  user_id               Int
  user                  User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mobile_auth_session_id Int?
  mobile_auth_session    MobileAuthSession? @relation(fields: [mobile_auth_session_id], references: [id], onDelete: Cascade)
  /// Stable per-install identifier supplied by the native client.
  device_id             String
  /// Native OS platform for this token.
  platform              NativePushPlatform @default(ANDROID)
  /// Push provider for the stored token. Expo is the first implementation; FCM can be added later.
  provider              NativePushProvider
  /// Provider-issued token, e.g. ExpoPushToken[...] for Expo development builds.
  token                 String
  /// Local date (UTC-normalized) when the last reminder was sent for this token.
  last_sent_local_date  DateTime?          @db.Date
  last_sent_weight_local_date DateTime?    @db.Date
  last_sent_food_local_date DateTime?      @db.Date
  revoked_at            DateTime?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  @@unique([provider, token])
  @@index([user_id])
  @@index([user_id, device_id])
  @@index([mobile_auth_session_id])
}

model ClientOperation {
  id               Int       @id @default(autoincrement())
  user_id          Int
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mobile_auth_session_id Int?
  mobile_auth_session MobileAuthSession? @relation(fields: [mobile_auth_session_id], references: [id], onDelete: SetNull)
  operation_id     String
  operation_kind   String
  request_hash     String
  response_status  Int?
  response_body    Json?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  @@unique([user_id, operation_id])
  @@index([user_id, created_at])
  @@index([mobile_auth_session_id, operation_kind, completed_at, created_at], map: "ClientOperation_mobile_session_kind_completed_created_idx")
}

model SyncChange {
  id             BigInt    @id @default(autoincrement())
  user_id        Int
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entity_type    String
  entity_id      String
  action         String
  operation_id   String?
  payload        Json?
  created_at     DateTime  @default(now())

  @@index([user_id, id])
  @@index([user_id, entity_type, entity_id])
}

model InAppNotification {
  id              Int                   @id @default(autoincrement())
  user_id         Int
  user            User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Reminder type used to select copy and action URLs in the frontend.
  type            InAppNotificationType
  /// Calendar day for this reminder, derived from the user's timezone.
  local_date      DateTime              @db.Date
  /// Optional notification title for generic/dev notifications.
  title           String?
  /// Optional notification body for generic/dev notifications.
  body            String?
  /// Optional deep link destination; reminder types fall back to known quick-add URLs.
  action_url      String?
  /// Optional dedupe key used to enforce one-per-key delivery while allowing repeated generic sends.
  dedupe_key      String?
  /// Read state for unread badge counts in the header bell + app icon.
  read_at         DateTime?
  /// User-initiated dismissal timestamp for explicit "not now" actions.
  dismissed_at    DateTime?
  /// Auto-resolution timestamp when logs are completed or the day rolls over.
  resolved_at     DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  @@unique([user_id, dedupe_key])
  @@index([user_id, created_at])
  @@index([user_id, dismissed_at, resolved_at])
}
