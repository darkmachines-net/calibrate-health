{
  "name": "backend",
  "version": "0.40.4",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:push:reset": "prisma db push --force-reset",
    "predb:seed": "npm run prisma:generate",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "start": "node dist/backend/src/index.js",
    "start:prod": "bash scripts/start-prod.sh",
    "pretest": "npm run prisma:generate",
    "test": "node -r ts-node/register --test",
    "test:weight-trend-lab": "node -r ts-node/register --test test/weight-trend-benchmark.test.js test/weight-trend-governance.test.js",
    "weight-trend:tuning-report": "node -r ts-node/register scripts/weight-trend-tuning-report.js",
    "weight-trend:tuning-report:check": "node -r ts-node/register scripts/weight-trend-tuning-report.js --check",
    "performance:regression": "node -r ts-node/register scripts/performance-regression.js",
    "pretest:coverage": "npm run prisma:generate",
    "test:coverage": "c8 node -r ts-node/register --test",
    "dev": "nodemon --watch src --watch ../shared --ext ts,json --exec ts-node src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.14.1",
    "prisma": "^7.9.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.4",
    "@types/web-push": "^3.6.4",
    "c8": "^12.0.0",
    "nodemon": "^3.1.11",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "c8": {
    "all": true,
    "reporter": [
      "text-summary",
      "html"
    ],
    "reports-dir": "coverage",
    "src": [
      "src",
      "../shared"
    ],
    "include": [
      "**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "exclude-after-remap": true
  },
  "overrides": {
    "body-parser": "2.3.0",
    "deepmerge-ts": "8.0.1",
    "fast-uri": "4.1.4",
    "find-my-way": "9.7.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "prisma": {
      ".": "$prisma",
      "mysql2": "3.24.3"
    },
    "qs": "6.16.0",
    "valibot": "1.4.2",
    "mysql2": "3.24.3"
  }
}
