{
  "name": "mobile",
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "preweb": "npm --prefix ../shared run build",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "prebuild:web": "npm --prefix ../shared run build",
    "build:web": "node ../scripts/expo-web-build.mjs",
    "preview:web": "node ../scripts/expo-web-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@calibrate/api-client": "file:../packages/api-client",
    "@calibrate/shared": "file:../shared",
    "@calibrate/wear-pairing": "file:modules/wear-pairing",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.100.10",
    "abort-controller": "^3.0.0",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health-connect": "3.5.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "regenerator-runtime": "^0.13.11",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "~30.5.2",
    "react-test-renderer": "19.3.0",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^expo/virtual/env$": "<rootDir>/test/expoVirtualEnv.js",
      "^expo-application$": "<rootDir>/test/expoApplication.js"
    },
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
