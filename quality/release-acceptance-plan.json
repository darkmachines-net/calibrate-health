{
  "schemaVersion": 5,
  "profile": "single-user-pre-release",
  "protocolPath": "quality/README.md",
  "releaseManifestPath": "shared/release.json",
  "releaseScopes": [
    "server-web",
    "ota",
    "native"
  ],
  "policy": {
    "pullRequestChecks": "lint-build-test",
    "externalReleaseApproval": "owner-discretion",
    "retainedEvidenceRequired": false
  },
  "automaticRequirements": [
    {
      "id": "pull-request-checks",
      "title": "Lint, type-check, build and test every pull request",
      "releaseScopes": [
        "server-web",
        "ota",
        "native"
      ],
      "trigger": "pull-request",
      "workflowPaths": [
        ".github/workflows/ci.yml"
      ],
      "jobIds": [
        "lint",
        "build",
        "tests"
      ]
    },
    {
      "id": "dependency-audit",
      "title": "Review dependency findings during scheduled or manual maintenance",
      "releaseScopes": [
        "server-web",
        "ota",
        "native"
      ],
      "trigger": "schedule-and-manual",
      "workflowPaths": [
        ".github/workflows/dependency-audit.yml"
      ],
      "jobIds": [
        "production-audit"
      ]
    },
    {
      "id": "production-container",
      "title": "Scan production containers during scheduled or manual maintenance",
      "releaseScopes": [
        "server-web"
      ],
      "trigger": "schedule-and-manual",
      "workflowPaths": [
        ".github/workflows/container-scan.yml"
      ],
      "jobIds": [
        "scan"
      ]
    },
    {
      "id": "prepared-release-integrity",
      "title": "Validate source and publish current-run artifacts through the pinned fixed workflow",
      "releaseScopes": [
        "server-web",
        "ota",
        "native"
      ],
      "trigger": "release",
      "workflowPaths": [
        ".github/workflows/release.yml"
      ],
      "jobIds": [
        "release"
      ]
    }
  ],
  "manualCapabilities": [
    {
      "id": "exhaustive-web-regression",
      "title": "Optional full browser, data-state, accessibility, and visual suites",
      "releaseScopes": [
        "server-web",
        "ota"
      ],
      "workflowPath": ".github/workflows/builds.yml",
      "jobIds": [
        "exported-web-e2e",
        "data-state-acceptance",
        "ux-regression"
      ]
    },
    {
      "id": "native-emulator-and-upgrade",
      "title": "Optional Android, Wear, and same-signer upgrade validation",
      "releaseScopes": [
        "native"
      ],
      "workflowPath": ".github/workflows/builds.yml",
      "jobIds": [
        "android-emulator-e2e",
        "wear-release-emulator-smoke",
        "native-package-upgrade"
      ]
    },
    {
      "id": "native-compilation",
      "title": "Optional Android phone, iOS Simulator and Wear compilation",
      "releaseScopes": [
        "native"
      ],
      "workflowPath": ".github/workflows/builds.yml",
      "jobIds": [
        "mobile-build",
        "ios-build",
        "wear-build"
      ]
    },
    {
      "id": "migration-safety",
      "title": "Optional populated database upgrades and historical rollback rehearsal",
      "releaseScopes": [
        "server-web"
      ],
      "workflowPath": ".github/workflows/database-upgrade.yml",
      "jobIds": [
        "populated-upgrade",
        "release-upgrade-rollback"
      ]
    }
  ]
}
